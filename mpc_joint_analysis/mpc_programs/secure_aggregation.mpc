"""
Secure Aggregation MPC Program

This program implements various secure aggregation protocols that allow
multiple parties to compute aggregate statistics while preserving privacy.
It includes federated learning aggregation, secure voting, and general
purpose aggregation functions.

Features:
- Federated Learning Model Aggregation
- Secure Voting and Consensus
- Privacy-Preserving Survey Aggregation
- Secure Statistical Aggregation
- Differential Privacy Integration
- Robust Aggregation (Byzantine fault tolerance)
"""

from Compiler.types import sint, sfix, cint, cfix, Array, Matrix
from Compiler.library import print_ln, for_range, if_
from Compiler.util import if_else
from Compiler.mpc_math import sqrt

# Configuration parameters
MAX_PARTIES = 20
MAX_MODEL_PARAMS = 1000
MAX_SURVEY_QUESTIONS = 100
MAX_VOTES = 1000
DIFFERENTIAL_PRIVACY_EPSILON = sfix(1.0)
BYZANTINE_THRESHOLD = sfix(0.33)  # Up to 33% Byzantine parties

def secure_federated_averaging(model_updates, model_sizes, n_parties, n_parameters):
    """
    Secure federated averaging for distributed machine learning.
    Computes weighted average of model updates based on dataset sizes.
    
    Args:
        model_updates: Matrix of model updates from each party
        model_sizes: Array of dataset sizes for each party
        n_parties: Number of participating parties
        n_parameters: Number of model parameters
    
    Returns:
        Aggregated model parameters
    """
    print_ln("Starting secure federated averaging...")
    print_ln("Parties: %s, Parameters: %s", n_parties, n_parameters)
    
    # Compute total dataset size
    total_size = sint(0)
    for party in range(n_parties):
        total_size += model_sizes[party]
    
    print_ln("Total dataset size: %s", total_size.reveal())
    
    # Initialize aggregated model
    aggregated_model = Array(n_parameters, sfix)
    for param in range(n_parameters):
        aggregated_model[param] = sfix(0)
    
    # Compute weighted average
    for party in range(n_parties):
        weight = sfix(model_sizes[party]) / sfix(total_size)
        print_ln("Party %s weight: %s", party, weight.reveal())
        
        for param in range(n_parameters):
            weighted_update = model_updates[party][param] * weight
            aggregated_model[param] += weighted_update
    
    return aggregated_model

def secure_federated_averaging_with_clipping(model_updates, model_sizes, n_parties, n_parameters, clip_norm):
    """
    Secure federated averaging with gradient clipping for privacy.
    
    Args:
        model_updates: Model updates from parties
        model_sizes: Dataset sizes
        n_parties: Number of parties
        n_parameters: Number of parameters
        clip_norm: Maximum allowed L2 norm for clipping
    
    Returns:
        Clipped and aggregated model
    """
    print_ln("Federated averaging with gradient clipping...")
    print_ln("Clip norm: %s", clip_norm.reveal())
    
    # Clip gradients for each party
    clipped_updates = Matrix(n_parties, n_parameters, sfix)
    
    for party in range(n_parties):
        # Compute L2 norm of update
        norm_squared = sfix(0)
        for param in range(n_parameters):
            update_val = model_updates[party][param]
            norm_squared += update_val * update_val
        
        current_norm = norm_squared.sqrt()
        
        # Compute clipping factor
        clip_factor = if_else(current_norm > clip_norm, 
                             clip_norm / current_norm, 
                             sfix(1))
        
        print_ln("Party %s: norm = %s, clip factor = %s", 
                party, current_norm.reveal(), clip_factor.reveal())
        
        # Apply clipping
        for param in range(n_parameters):
            clipped_updates[party][param] = model_updates[party][param] * clip_factor
    
    # Perform standard federated averaging on clipped updates
    return secure_federated_averaging(clipped_updates, model_sizes, n_parties, n_parameters)

def secure_add_differential_privacy_noise(aggregated_values, n_parameters, sensitivity, epsilon):
    """
    Add differential privacy noise to aggregated values.
    
    Args:
        aggregated_values: Values to add noise to
        n_parameters: Number of parameters
        sensitivity: Sensitivity of the aggregation function
        epsilon: Privacy parameter
    
    Returns:
        Values with differential privacy noise
    """
    print_ln("Adding differential privacy noise...")
    print_ln("Epsilon: %s, Sensitivity: %s", epsilon.reveal(), sensitivity.reveal())
    
    noisy_values = Array(n_parameters, sfix)
    
    # Laplace noise scale
    noise_scale = sensitivity / epsilon
    
    for param in range(n_parameters):
        # Generate Laplace noise (simplified using normal approximation)
        # In practice, you'd use proper Laplace sampling
        noise = sfix(0.1) * noise_scale  # Simplified noise generation
        
        noisy_values[param] = aggregated_values[param] + noise
    
    print_ln("Differential privacy noise added with scale: %s", noise_scale.reveal())
    return noisy_values

def secure_voting_aggregation(votes, vote_weights, n_parties, n_candidates):
    """
    Secure voting aggregation with weighted votes.
    
    Args:
        votes: Matrix of votes (party x candidate)
        vote_weights: Weight of each party's vote
        n_parties: Number of voting parties
        n_candidates: Number of candidates/options
    
    Returns:
        Vote tallies and winner
    """
    print_ln("Starting secure voting aggregation...")
    print_ln("Parties: %s, Candidates: %s", n_parties, n_candidates)
    
    # Initialize vote tallies
    tallies = Array(n_candidates, sfix)
    for candidate in range(n_candidates):
        tallies[candidate] = sfix(0)
    
    # Aggregate weighted votes
    total_weight = sfix(0)
    for party in range(n_parties):
        party_weight = vote_weights[party]
        total_weight += party_weight
        
        for candidate in range(n_candidates):
            weighted_vote = votes[party][candidate] * party_weight
            tallies[candidate] += weighted_vote
    
    # Normalize by total weight
    for candidate in range(n_candidates):
        tallies[candidate] = tallies[candidate] / total_weight
    
    # Find winner
    winner = sint(0)
    max_votes = tallies[0]
    
    for candidate in range(1, n_candidates):
        is_higher = tallies[candidate] > max_votes
        winner = if_else(is_higher, candidate, winner)
        max_votes = if_else(is_higher, tallies[candidate], max_votes)
    
    print_ln("Voting completed. Winner: candidate %s with %s votes", 
             winner.reveal(), max_votes.reveal())
    
    return tallies, winner

def secure_survey_aggregation(responses, response_weights, n_parties, n_questions, aggregation_type):
    """
    Secure aggregation of survey responses.
    
    Args:
        responses: Matrix of survey responses
        response_weights: Weight/importance of each response
        n_parties: Number of survey participants
        n_questions: Number of survey questions
        aggregation_type: 0=mean, 1=median, 2=mode
    
    Returns:
        Aggregated survey results
    """
    print_ln("Starting secure survey aggregation...")
    print_ln("Participants: %s, Questions: %s", n_parties, n_questions)
    
    aggregated_results = Array(n_questions, sfix)
    
    for question in range(n_questions):
        if aggregation_type == 0:  # Weighted mean
            weighted_sum = sfix(0)
            total_weight = sfix(0)
            
            for party in range(n_parties):
                weight = response_weights[party]
                weighted_sum += responses[party][question] * weight
                total_weight += weight
            
            aggregated_results[question] = weighted_sum / total_weight
            
        elif aggregation_type == 1:  # Median (simplified)
            # Simplified median computation
            # In practice, you'd use secure sorting
            sum_responses = sfix(0)
            for party in range(n_parties):
                sum_responses += responses[party][question]
            aggregated_results[question] = sum_responses / n_parties
            
        else:  # Mode (simplified as most frequent value)
            # Simplified mode computation
            # Find most common value (assuming discrete values 1-5)
            max_count = sint(0)
            mode_value = sfix(1)
            
            for value in range(1, 6):  # Assuming 5-point scale
                count = sint(0)
                for party in range(n_parties):
                    is_equal = if_else(responses[party][question] == sfix(value), 1, 0)
                    count += is_equal
                
                is_more_frequent = count > max_count
                mode_value = if_else(is_more_frequent, sfix(value), mode_value)
                max_count = if_else(is_more_frequent, count, max_count)
            
            aggregated_results[question] = mode_value
        
        print_ln("Question %s result: %s", question, aggregated_results[question].reveal())
    
    return aggregated_results

def secure_robust_aggregation_trimmed_mean(values, n_parties, trim_ratio):
    """
    Robust aggregation using trimmed mean to handle outliers.
    
    Args:
        values: Array of values from different parties
        n_parties: Number of parties
        trim_ratio: Fraction of extreme values to trim (0.0 to 0.5)
    
    Returns:
        Trimmed mean
    """
    print_ln("Computing robust trimmed mean...")
    print_ln("Trim ratio: %s", trim_ratio.reveal())
    
    # Simple sorting for trimming (in practice, use secure sorting)
    # For demonstration, we'll approximate by removing extreme values
    
    # Compute mean and standard deviation
    mean = sfix(0)
    for party in range(n_parties):
        mean += values[party]
    mean = mean / n_parties
    
    variance = sfix(0)
    for party in range(n_parties):
        diff = values[party] - mean
        variance += diff * diff
    variance = variance / (n_parties - 1)
    std_dev = variance.sqrt()
    
    # Remove values that are too far from mean (simplified trimming)
    threshold = std_dev * sfix(2)  # 2 standard deviations
    
    trimmed_sum = sfix(0)
    trimmed_count = sint(0)
    
    for party in range(n_parties):
        diff_from_mean = if_else(values[party] >= mean, 
                               values[party] - mean, 
                               mean - values[party])
        
        is_not_outlier = diff_from_mean <= threshold
        
        contribution = if_else(is_not_outlier, values[party], sfix(0))
        trimmed_sum += contribution
        trimmed_count += if_else(is_not_outlier, 1, 0)
    
    trimmed_mean = trimmed_sum / sfix(trimmed_count)
    
    print_ln("Trimmed mean: %s (used %s/%s values)", 
             trimmed_mean.reveal(), trimmed_count.reveal(), n_parties)
    
    return trimmed_mean

def secure_byzantine_robust_aggregation(values, n_parties, byzantine_threshold):
    """
    Byzantine-robust aggregation that tolerates malicious parties.
    
    Args:
        values: Values from different parties
        n_parties: Number of parties
        byzantine_threshold: Maximum fraction of Byzantine parties
    
    Returns:
        Byzantine-robust aggregate
    """
    print_ln("Computing Byzantine-robust aggregation...")
    
    max_byzantine = sint(int(float(byzantine_threshold.reveal()) * n_parties))
    print_ln("Max Byzantine parties: %s", max_byzantine.reveal())
    
    # Simplified Byzantine robustness using median-based approach
    # In practice, you'd use more sophisticated algorithms like
    # coordinate-wise median or geometric median
    
    # Compute standard mean
    standard_mean = sfix(0)
    for party in range(n_parties):
        standard_mean += values[party]
    standard_mean = standard_mean / n_parties
    
    # Compute deviations from mean
    deviations = Array(n_parties, sfix)
    for party in range(n_parties):
        diff = values[party] - standard_mean
        deviations[party] = if_else(diff >= 0, diff, -diff)
    
    # Find parties with largest deviations (potential Byzantine)
    # Remove top k deviations where k = max_byzantine
    
    # Simplified: compute mean excluding extreme values
    sum_values = sfix(0)
    count_values = sint(0)
    
    # Find threshold for excluding outliers
    max_deviation = deviations[0]
    for party in range(1, n_parties):
        max_deviation = if_else(deviations[party] > max_deviation, 
                              deviations[party], 
                              max_deviation)
    
    exclusion_threshold = max_deviation * sfix(0.7)  # Exclude top 30% of deviations
    
    for party in range(n_parties):
        should_include = deviations[party] <= exclusion_threshold
        
        contribution = if_else(should_include, values[party], sfix(0))
        sum_values += contribution
        count_values += if_else(should_include, 1, 0)
    
    robust_mean = sum_values / sfix(count_values)
    
    print_ln("Byzantine-robust mean: %s (used %s/%s parties)", 
             robust_mean.reveal(), count_values.reveal(), n_parties)
    
    return robust_mean

def secure_multi_dimensional_aggregation(data_matrix, n_parties, n_dimensions, aggregation_weights):
    """
    Secure aggregation for multi-dimensional data.
    
    Args:
        data_matrix: Matrix of multi-dimensional data from parties
        n_parties: Number of parties
        n_dimensions: Number of dimensions
        aggregation_weights: Weights for each party
    
    Returns:
        Aggregated multi-dimensional result
    """
    print_ln("Multi-dimensional secure aggregation...")
    print_ln("Parties: %s, Dimensions: %s", n_parties, n_dimensions)
    
    aggregated_result = Array(n_dimensions, sfix)
    
    # Normalize weights
    total_weight = sfix(0)
    for party in range(n_parties):
        total_weight += aggregation_weights[party]
    
    for dimension in range(n_dimensions):
        weighted_sum = sfix(0)
        
        for party in range(n_parties):
            normalized_weight = aggregation_weights[party] / total_weight
            weighted_contribution = data_matrix[party][dimension] * normalized_weight
            weighted_sum += weighted_contribution
        
        aggregated_result[dimension] = weighted_sum
        print_ln("Dimension %s: %s", dimension, aggregated_result[dimension].reveal())
    
    return aggregated_result

def secure_time_series_aggregation(time_series_data, n_parties, n_time_points, aggregation_method):
    """
    Secure aggregation of time series data.
    
    Args:
        time_series_data: Matrix of time series from different parties
        n_parties: Number of parties
        n_time_points: Number of time points
        aggregation_method: 0=mean, 1=median, 2=trend
    
    Returns:
        Aggregated time series
    """
    print_ln("Time series secure aggregation...")
    
    aggregated_series = Array(n_time_points, sfix)
    
    for time_point in range(n_time_points):
        if aggregation_method == 0:  # Mean
            sum_value = sfix(0)
            for party in range(n_parties):
                sum_value += time_series_data[party][time_point]
            aggregated_series[time_point] = sum_value / n_parties
            
        elif aggregation_method == 1:  # Median (simplified)
            # Simplified median
            sum_value = sfix(0)
            for party in range(n_parties):
                sum_value += time_series_data[party][time_point]
            aggregated_series[time_point] = sum_value / n_parties
            
        else:  # Trend analysis
            # Compute local trend around this time point
            if time_point > 0 and time_point < n_time_points - 1:
                prev_sum = sfix(0)
                curr_sum = sfix(0)
                next_sum = sfix(0)
                
                for party in range(n_parties):
                    prev_sum += time_series_data[party][time_point - 1]
                    curr_sum += time_series_data[party][time_point]
                    next_sum += time_series_data[party][time_point + 1]
                
                prev_avg = prev_sum / n_parties
                curr_avg = curr_sum / n_parties
                next_avg = next_sum / n_parties
                
                # Simple trend: (next - prev) / 2
                trend = (next_avg - prev_avg) / sfix(2)
                aggregated_series[time_point] = curr_avg + trend
            else:
                # For boundary points, use simple average
                sum_value = sfix(0)
                for party in range(n_parties):
                    sum_value += time_series_data[party][time_point]
                aggregated_series[time_point] = sum_value / n_parties
    
    return aggregated_series

def secure_hierarchical_aggregation(hierarchical_data, n_parties, n_levels, level_weights):
    """
    Secure hierarchical aggregation for structured data.
    
    Args:
        hierarchical_data: Multi-level data structure
        n_parties: Number of parties
        n_levels: Number of hierarchy levels
        level_weights: Weights for each level
    
    Returns:
        Hierarchically aggregated result
    """
    print_ln("Hierarchical secure aggregation...")
    
    # Aggregate at each level
    level_results = Array(n_levels, sfix)
    
    for level in range(n_levels):
        level_sum = sfix(0)
        level_count = sint(0)
        
        for party in range(n_parties):
            # Access hierarchical data at specific level
            # This is simplified - in practice you'd have a proper hierarchy
            data_point = hierarchical_data[party * n_levels + level]
            level_sum += data_point
            level_count += 1
        
        level_average = level_sum / sfix(level_count)
        level_results[level] = level_average * level_weights[level]
        
        print_ln("Level %s result: %s", level, level_results[level].reveal())
    
    # Combine results across levels
    final_result = sfix(0)
    total_weight = sfix(0)
    
    for level in range(n_levels):
        final_result += level_results[level]
        total_weight += level_weights[level]
    
    final_result = final_result / total_weight
    
    print_ln("Final hierarchical result: %s", final_result.reveal())
    return final_result

def main():
    """
    Main function demonstrating secure aggregation protocols.
    """
    print_ln("Starting Secure Aggregation MPC Program")
    
    # Initialize parameters
    n_parties = cint(5)
    n_parameters = cint(10)
    n_candidates = cint(3)
    n_questions = cint(5)
    
    print_ln("Configuration:")
    print_ln("Number of parties: %s", n_parties)
    print_ln("Model parameters: %s", n_parameters)
    print_ln("Voting candidates: %s", n_candidates)
    print_ln("Survey questions: %s", n_questions)
    
    # === FEDERATED LEARNING AGGREGATION ===
    print_ln("\n=== FEDERATED LEARNING AGGREGATION ===")
    
    # Initialize model updates and dataset sizes
    model_updates = Matrix(n_parties, n_parameters, sfix)
    dataset_sizes = Array(n_parties, sint)
    
    print_ln("Reading federated learning data...")
    for party in range(n_parties):
        print_ln("Party %s model updates:", party)
        dataset_sizes[party] = sint.get_input_from(party)
        
        for param in range(n_parameters):
            model_updates[party][param] = sfix.get_input_from(party)
    
    # Standard federated averaging
    aggregated_model = secure_federated_averaging(
        model_updates, dataset_sizes, n_parties, n_parameters
    )
    
    print_ln("Federated averaging completed")
    print_ln("Sample aggregated parameters:")
    for i in range(min(3, n_parameters)):
        print_ln("Param[%s]: %s", i, aggregated_model[i].reveal())
    
    # Federated averaging with clipping
    clip_norm = sfix(1.0)
    clipped_model = secure_federated_averaging_with_clipping(
        model_updates, dataset_sizes, n_parties, n_parameters, clip_norm
    )
    
    print_ln("Clipped federated averaging completed")
    
    # Add differential privacy
    dp_model = secure_add_differential_privacy_noise(
        clipped_model, n_parameters, sfix(0.1), DIFFERENTIAL_PRIVACY_EPSILON
    )
    
    print_ln("Differential privacy added")
    
    # === SECURE VOTING ===
    print_ln("\n=== SECURE VOTING ===")
    
    votes = Matrix(n_parties, n_candidates, sfix)
    vote_weights = Array(n_parties, sfix)
    
    print_ln("Reading voting data...")
    for party in range(n_parties):
        vote_weights[party] = sfix.get_input_from(party)
        
        for candidate in range(n_candidates):
            votes[party][candidate] = sfix.get_input_from(party)
    
    vote_tallies, winner = secure_voting_aggregation(
        votes, vote_weights, n_parties, n_candidates
    )
    
    print_ln("Voting results:")
    for candidate in range(n_candidates):
        print_ln("Candidate %s: %s votes", candidate, vote_tallies[candidate].reveal())
    print_ln("Winner: Candidate %s", winner.reveal())
    
    # === SURVEY AGGREGATION ===
    print_ln("\n=== SURVEY AGGREGATION ===")
    
    survey_responses = Matrix(n_parties, n_questions, sfix)
    response_weights = Array(n_parties, sfix)
    
    print_ln("Reading survey data...")
    for party in range(n_parties):
        response_weights[party] = sfix.get_input_from(party)
        
        for question in range(n_questions):
            survey_responses[party][question] = sfix.get_input_from(party)
    
    # Aggregate using mean
    survey_results = secure_survey_aggregation(
        survey_responses, response_weights, n_parties, n_questions, 0
    )
    
    print_ln("Survey aggregation results (weighted mean):")
    for question in range(n_questions):
        print_ln("Question %s: %s", question, survey_results[question].reveal())
    
    # === ROBUST AGGREGATION ===
    print_ln("\n=== ROBUST AGGREGATION ===")
    
    # Test robust aggregation with sample values
    test_values = Array(n_parties, sfix)
    print_ln("Reading test values for robust aggregation...")
    for party in range(n_parties):
        test_values[party] = sfix.get_input_from(party)
    
    # Trimmed mean
    trimmed_result = secure_robust_aggregation_trimmed_mean(
        test_values, n_parties, sfix(0.2)
    )
    print_ln("Trimmed mean result: %s", trimmed_result.reveal())
    
    # Byzantine-robust aggregation
    byzantine_result = secure_byzantine_robust_aggregation(
        test_values, n_parties, BYZANTINE_THRESHOLD
    )
    print_ln("Byzantine-robust result: %s", byzantine_result.reveal())
    
    # === MULTI-DIMENSIONAL AGGREGATION ===
    print_ln("\n=== MULTI-DIMENSIONAL AGGREGATION ===")
    
    n_dimensions = cint(3)
    multi_data = Matrix(n_parties, n_dimensions, sfix)
    multi_weights = Array(n_parties, sfix)
    
    print_ln("Reading multi-dimensional data...")
    for party in range(n_parties):
        multi_weights[party] = sfix.get_input_from(party)
        
        for dim in range(n_dimensions):
            multi_data[party][dim] = sfix.get_input_from(party)
    
    multi_result = secure_multi_dimensional_aggregation(
        multi_data, n_parties, n_dimensions, multi_weights
    )
    
    print_ln("Multi-dimensional aggregation completed")
    print_ln("Results per dimension:")
    for dim in range(n_dimensions):
        print_ln("Dimension %s: %s", dim, multi_result[dim].reveal())
    
    # === TIME SERIES AGGREGATION ===
    print_ln("\n=== TIME SERIES AGGREGATION ===")
    
    n_time_points = cint(7)  # Week of data
    time_series = Matrix(n_parties, n_time_points, sfix)
    
    print_ln("Reading time series data...")
    for party in range(n_parties):
        for time_point in range(n_time_points):
            time_series[party][time_point] = sfix.get_input_from(party)
    
    ts_result = secure_time_series_aggregation(
        time_series, n_parties, n_time_points, 0  # Mean aggregation
    )
    
    print_ln("Time series aggregation completed")
    print_ln("Aggregated time series:")
    for t in range(n_time_points):
        print_ln("Time %s: %s", t, ts_result[t].reveal())
    
    print_ln("\nSecure Aggregation completed successfully!")
    print_ln("Summary:")
    print_ln("- Federated Learning: Model aggregated with DP noise")
    print_ln("- Voting: Winner determined securely")
    print_ln("- Survey: %s questions aggregated", n_questions)
    print_ln("- Robust: Byzantine-resistant aggregation performed")
    print_ln("- Multi-dimensional: %s dimensions aggregated", n_dimensions)
    print_ln("- Time Series: %s time points aggregated", n_time_points)

if __name__ == "__main__":
    main()