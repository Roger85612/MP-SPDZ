"""
Joint Statistics MPC Program

This program computes joint statistical measures across multiple parties' data
using secure multi-party computation. It implements secure computation of:
- Mean, variance, standard deviation
- Correlation coefficients
- Covariance matrices
- Quantiles and percentiles
- Histograms and frequency distributions

The program is designed to work with various MP-SPDZ protocols and supports
both field and ring arithmetic.
"""

from Compiler.types import sint, sfix, cint, cfix, Array, Matrix
from Compiler.library import print_ln, for_range, if_
from Compiler.util import if_else
import random

# Configuration parameters
MAX_PARTIES = 10
MAX_DATA_SIZE = 1000
PRECISION_BITS = 16

def secure_mean(data, n_parties, data_size):
    """
    Compute secure mean across multiple parties.
    
    Args:
        data: Array of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
    
    Returns:
        Secure mean value
    """
    total_sum = sfix(0)
    total_count = cint(0)
    
    # Sum all values across parties
    for i in range(n_parties):
        party_sum = sfix(0)
        for j in range(data_size):
            party_sum += data[i * data_size + j]
        total_sum += party_sum
        total_count += data_size
    
    # Compute mean
    mean = total_sum / total_count
    return mean

def secure_variance(data, n_parties, data_size, mean=None):
    """
    Compute secure variance across multiple parties.
    
    Args:
        data: Array of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
        mean: Pre-computed mean (optional)
    
    Returns:
        Secure variance value
    """
    if mean is None:
        mean = secure_mean(data, n_parties, data_size)
    
    sum_squared_diff = sfix(0)
    total_count = cint(0)
    
    # Sum squared differences from mean
    for i in range(n_parties):
        for j in range(data_size):
            diff = data[i * data_size + j] - mean
            sum_squared_diff += diff * diff
        total_count += data_size
    
    # Compute variance
    variance = sum_squared_diff / (total_count - 1)
    return variance

def secure_covariance(data_x, data_y, n_parties, data_size, mean_x=None, mean_y=None):
    """
    Compute secure covariance between two variables.
    
    Args:
        data_x: First variable data
        data_y: Second variable data
        n_parties: Number of parties
        data_size: Size of data per party
        mean_x: Pre-computed mean of x (optional)
        mean_y: Pre-computed mean of y (optional)
    
    Returns:
        Secure covariance value
    """
    if mean_x is None:
        mean_x = secure_mean(data_x, n_parties, data_size)
    if mean_y is None:
        mean_y = secure_mean(data_y, n_parties, data_size)
    
    sum_product_diff = sfix(0)
    total_count = cint(0)
    
    # Sum products of differences from means
    for i in range(n_parties):
        for j in range(data_size):
            diff_x = data_x[i * data_size + j] - mean_x
            diff_y = data_y[i * data_size + j] - mean_y
            sum_product_diff += diff_x * diff_y
        total_count += data_size
    
    # Compute covariance
    covariance = sum_product_diff / (total_count - 1)
    return covariance

def secure_correlation(data_x, data_y, n_parties, data_size):
    """
    Compute secure Pearson correlation coefficient.
    
    Args:
        data_x: First variable data
        data_y: Second variable data
        n_parties: Number of parties
        data_size: Size of data per party
    
    Returns:
        Secure correlation coefficient
    """
    mean_x = secure_mean(data_x, n_parties, data_size)
    mean_y = secure_mean(data_y, n_parties, data_size)
    
    var_x = secure_variance(data_x, n_parties, data_size, mean_x)
    var_y = secure_variance(data_y, n_parties, data_size, mean_y)
    
    cov_xy = secure_covariance(data_x, data_y, n_parties, data_size, mean_x, mean_y)
    
    # Compute correlation coefficient
    # correlation = covariance / (std_x * std_y)
    correlation = cov_xy / (var_x.sqrt() * var_y.sqrt())
    return correlation

def secure_quantile(data, n_parties, data_size, quantile_level):
    """
    Compute secure quantile using a privacy-preserving sorting approach.
    
    Args:
        data: Array of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
        quantile_level: Quantile level (0.0 to 1.0)
    
    Returns:
        Secure quantile value
    """
    total_size = n_parties * data_size
    
    # Create array for all data
    all_data = Array(total_size, sfix)
    for i in range(total_size):
        all_data[i] = data[i]
    
    # Sort the data using secure sorting
    sorted_data = secure_sort(all_data, total_size)
    
    # Find quantile position
    position = cint(int(quantile_level * (total_size - 1)))
    
    # Return value at quantile position
    return sorted_data[position]

def secure_sort(data, size):
    """
    Secure sorting using bitonic sort algorithm.
    
    Args:
        data: Array of secret-shared values
        size: Size of array
    
    Returns:
        Sorted array
    """
    # Bitonic sort implementation
    # This is a simplified version - in practice, you'd use a more efficient algorithm
    
    sorted_data = Array(size, sfix)
    for i in range(size):
        sorted_data[i] = data[i]
    
    # Bitonic sort passes
    k = 2
    while k <= size:
        j = k // 2
        while j > 0:
            for i in range(size):
                l = i ^ j
                if l > i:
                    if ((i & k) == 0 and sorted_data[i] > sorted_data[l]) or \
                       ((i & k) != 0 and sorted_data[i] < sorted_data[l]):
                        # Swap elements
                        temp = sorted_data[i]
                        sorted_data[i] = sorted_data[l]
                        sorted_data[l] = temp
            j = j // 2
        k = k * 2
    
    return sorted_data

def secure_histogram(data, n_parties, data_size, n_bins, min_val, max_val):
    """
    Compute secure histogram.
    
    Args:
        data: Array of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
        n_bins: Number of histogram bins
        min_val: Minimum value for histogram
        max_val: Maximum value for histogram
    
    Returns:
        Array of bin counts
    """
    bin_counts = Array(n_bins, sint)
    for i in range(n_bins):
        bin_counts[i] = sint(0)
    
    bin_width = (max_val - min_val) / n_bins
    
    # Count values in each bin
    for i in range(n_parties):
        for j in range(data_size):
            value = data[i * data_size + j]
            
            # Determine which bin this value belongs to
            bin_index = sint((value - min_val) / bin_width)
            
            # Clamp bin index to valid range
            bin_index = if_else(bin_index < 0, 0, bin_index)
            bin_index = if_else(bin_index >= n_bins, n_bins - 1, bin_index)
            
            # Increment appropriate bin count
            for k in range(n_bins):
                bin_counts[k] += if_else(bin_index == k, 1, 0)
    
    return bin_counts

def secure_covariance_matrix(data_matrix, n_parties, data_size, n_variables):
    """
    Compute secure covariance matrix for multiple variables.
    
    Args:
        data_matrix: Matrix of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
        n_variables: Number of variables
    
    Returns:
        Covariance matrix
    """
    # Initialize covariance matrix
    cov_matrix = Matrix(n_variables, n_variables, sfix)
    
    # Compute means for all variables
    means = Array(n_variables, sfix)
    for var in range(n_variables):
        var_data = Array(n_parties * data_size, sfix)
        for i in range(n_parties * data_size):
            var_data[i] = data_matrix[i][var]
        means[var] = secure_mean(var_data, n_parties, data_size)
    
    # Compute covariance for each pair of variables
    for i in range(n_variables):
        for j in range(n_variables):
            if i <= j:  # Only compute upper triangle (matrix is symmetric)
                var_i_data = Array(n_parties * data_size, sfix)
                var_j_data = Array(n_parties * data_size, sfix)
                
                for k in range(n_parties * data_size):
                    var_i_data[k] = data_matrix[k][i]
                    var_j_data[k] = data_matrix[k][j]
                
                cov_matrix[i][j] = secure_covariance(
                    var_i_data, var_j_data, n_parties, data_size, means[i], means[j]
                )
                
                # Fill symmetric entry
                if i != j:
                    cov_matrix[j][i] = cov_matrix[i][j]
    
    return cov_matrix

def secure_summary_statistics(data, n_parties, data_size):
    """
    Compute comprehensive summary statistics.
    
    Args:
        data: Array of secret-shared values
        n_parties: Number of parties
        data_size: Size of data per party
    
    Returns:
        Dictionary-like structure with statistics
    """
    # Compute basic statistics
    mean = secure_mean(data, n_parties, data_size)
    variance = secure_variance(data, n_parties, data_size, mean)
    std_dev = variance.sqrt()
    
    # Compute quantiles
    q25 = secure_quantile(data, n_parties, data_size, 0.25)
    median = secure_quantile(data, n_parties, data_size, 0.5)
    q75 = secure_quantile(data, n_parties, data_size, 0.75)
    
    # Find min and max
    sorted_data = secure_sort(data, n_parties * data_size)
    min_val = sorted_data[0]
    max_val = sorted_data[n_parties * data_size - 1]
    
    return {
        'mean': mean,
        'variance': variance,
        'std_dev': std_dev,
        'min': min_val,
        'max': max_val,
        'q25': q25,
        'median': median,
        'q75': q75
    }

def main():
    """
    Main function to demonstrate joint statistics computation.
    """
    print_ln("Starting Joint Statistics MPC Program")
    
    # Initialize parameters
    n_parties = cint(3)  # Number of parties
    data_size = cint(100)  # Data size per party
    
    # Create sample data arrays
    data_x = Array(n_parties * data_size, sfix)
    data_y = Array(n_parties * data_size, sfix)
    
    # Input data from parties
    print_ln("Reading input data from parties...")
    for i in range(n_parties):
        print_ln("Party %s:", i)
        for j in range(data_size):
            index = i * data_size + j
            data_x[index] = sfix.get_input_from(i)
            data_y[index] = sfix.get_input_from(i)
    
    print_ln("Computing joint statistics...")
    
    # Compute basic statistics for X
    print_ln("Computing statistics for variable X:")
    stats_x = secure_summary_statistics(data_x, n_parties, data_size)
    print_ln("Mean X: %s", stats_x['mean'].reveal())
    print_ln("Std Dev X: %s", stats_x['std_dev'].reveal())
    print_ln("Min X: %s", stats_x['min'].reveal())
    print_ln("Max X: %s", stats_x['max'].reveal())
    print_ln("Median X: %s", stats_x['median'].reveal())
    
    # Compute basic statistics for Y
    print_ln("Computing statistics for variable Y:")
    stats_y = secure_summary_statistics(data_y, n_parties, data_size)
    print_ln("Mean Y: %s", stats_y['mean'].reveal())
    print_ln("Std Dev Y: %s", stats_y['std_dev'].reveal())
    print_ln("Min Y: %s", stats_y['min'].reveal())
    print_ln("Max Y: %s", stats_y['max'].reveal())
    print_ln("Median Y: %s", stats_y['median'].reveal())
    
    # Compute correlation
    print_ln("Computing correlation between X and Y:")
    correlation = secure_correlation(data_x, data_y, n_parties, data_size)
    print_ln("Correlation X-Y: %s", correlation.reveal())
    
    # Compute covariance
    print_ln("Computing covariance between X and Y:")
    covariance = secure_covariance(data_x, data_y, n_parties, data_size)
    print_ln("Covariance X-Y: %s", covariance.reveal())
    
    # Compute histogram for X
    print_ln("Computing histogram for variable X:")
    n_bins = cint(10)
    histogram = secure_histogram(data_x, n_parties, data_size, n_bins, 
                                stats_x['min'], stats_x['max'])
    
    for i in range(n_bins):
        print_ln("Bin %s: %s", i, histogram[i].reveal())
    
    print_ln("Joint Statistics computation completed successfully!")

if __name__ == "__main__":
    main()