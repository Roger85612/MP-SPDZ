"""
金融机构联合风险评估MPC程序 (增强版) - financial_joint_analysis.mpc
多银行信贷风险分析 - 保护客户隐私的安全计算
三家银行：花旗银行、摩根大通、美国银行
相比joint_statistics.mpc的全面增强版本
"""

from Compiler.types import sint, sfix, cint
from Compiler.library import print_ln

def main():
    """金融风险评估主函数"""
    
    print_ln("=== 启动金融机构联合风险评估MPC程序 ===")
    print_ln("多银行信贷风险分析 - 隐私保护安全计算")
    
    # 分析参数设置
    n_banks = 3
    customers_per_bank = 100  # 每家银行100个客户样本
    total_customers = n_banks * customers_per_bank
    
    print_ln("分析参数: %s家银行, 每行%s客户, 总计%s客户", 
             n_banks, customers_per_bank, total_customers)
    
    # 数据存储结构
    credit_scores = []          # 信用评分 (300-850)
    annual_incomes = []         # 年收入 (千美元)
    debt_ratios = []           # 债务收入比 (%)
    loan_defaults = []         # 违约标志 (0=正常, 1=违约)
    
    # 从各银行读取客户数据
    print_ln("开始读取各银行客户数据...")
    
    for bank_id in range(n_banks):
        print_ln("读取银行 %s 的客户数据...", bank_id)
        
        for customer_id in range(customers_per_bank):
            # 读取客户数据
            credit_score = sint.get_input_from(bank_id)
            income = sint.get_input_from(bank_id)
            debt_ratio = sint.get_input_from(bank_id)
            default_flag = sint.get_input_from(bank_id)
            
            # 存储数据
            credit_scores.append(credit_score)
            annual_incomes.append(income)
            debt_ratios.append(debt_ratio)
            loan_defaults.append(default_flag)
        
        print_ln("银行 %s 数据读取完成", bank_id)
    
    print_ln("所有银行客户数据读取完成")
    
    # ============ 基础统计分析 ============
    print_ln("开始进行基础统计分析...")
    
    # 计算平均信用评分
    sum_credit = sint(0)
    for score in credit_scores:
        sum_credit = sum_credit + score
    mean_credit_score = sum_credit / total_customers
    
    # 计算平均年收入
    sum_income = sint(0)
    for income in annual_incomes:
        sum_income = sum_income + income
    mean_income = sum_income / total_customers
    
    # 计算平均债务收入比
    sum_debt_ratio = sint(0)
    for ratio in debt_ratios:
        sum_debt_ratio = sum_debt_ratio + ratio
    mean_debt_ratio = sum_debt_ratio / total_customers
    
    # ============ 风险评估分析 ============
    print_ln("开始进行风险评估分析...")
    
    # 计算总体违约率
    sum_defaults = sint(0)
    for default in loan_defaults:
        sum_defaults = sum_defaults + default
    overall_default_rate = (sum_defaults * 100) / total_customers
    
    # ============ 信用评分分层分析 ============
    print_ln("开始进行信用评分分层分析...")
    
    # 按信用评分分组统计违约率
    excellent_count = sint(0)    # 750+
    good_count = sint(0)         # 700-749
    fair_count = sint(0)         # 650-699
    poor_count = sint(0)         # <650
    
    excellent_defaults = sint(0)
    good_defaults = sint(0)
    fair_defaults = sint(0)
    poor_defaults = sint(0)
    
    for i in range(total_customers):
        score = credit_scores[i]
        default = loan_defaults[i]
        
        is_excellent = (score >= 750)
        is_good = ((score >= 700) * (score < 750))
        is_fair = ((score >= 650) * (score < 700))
        is_poor = (score < 650)
        
        excellent_count = excellent_count + is_excellent
        good_count = good_count + is_good
        fair_count = fair_count + is_fair
        poor_count = poor_count + is_poor
        
        excellent_defaults = excellent_defaults + (default * is_excellent)
        good_defaults = good_defaults + (default * is_good)
        fair_defaults = fair_defaults + (default * is_fair)
        poor_defaults = poor_defaults + (default * is_poor)
    
    # ============ 风险预警指标计算 ============
    print_ln("开始计算风险预警指标...")
    
    # 高风险客户统计 (债务收入比>45%且信用评分<700)
    high_risk_count = sint(0)
    for i in range(total_customers):
        is_high_risk = ((debt_ratios[i] > 45) * (credit_scores[i] < 700))
        high_risk_count = high_risk_count + is_high_risk
    
    high_risk_rate = (high_risk_count * 100) / total_customers
    
    # 优质客户统计 (信用评分>750且债务收入比<30%)
    premium_count = sint(0)
    for i in range(total_customers):
        is_premium = ((credit_scores[i] > 750) * (debt_ratios[i] < 30))
        premium_count = premium_count + is_premium
    
    premium_rate = (premium_count * 100) / total_customers
    
    # ============ 金融风险评估结果披露 ============
    print_ln("=== FINANCIAL_DISCLOSURE ===")
    print_ln("FINANCIAL_DISCLOSURE - 平均信用评分: %s", mean_credit_score.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 平均年收入: %s", mean_income.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 平均债务收入比: %s", mean_debt_ratio.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 总体违约率: %s", overall_default_rate.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 优秀信用客户数: %s", excellent_count.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 良好信用客户数: %s", good_count.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 一般信用客户数: %s", fair_count.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 较差信用客户数: %s", poor_count.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 高风险客户比例: %s", high_risk_rate.reveal())
    print_ln("FINANCIAL_DISCLOSURE - 优质客户比例: %s", premium_rate.reveal())
    print_ln("=== END_FINANCIAL_DISCLOSURE ===")
    print_ln("=== 金融机构联合风险评估MPC程序执行完成 ===")

# 执行主函数
main()